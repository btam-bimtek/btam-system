rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Gambar soal — admin (authenticated) bisa upload, semua bisa baca
    match /bank-soal/{allPaths=**} {
      allow read;
      allow write: if request.auth != null;
    }

    // KTP pendaftar — publik bisa upload (form tanpa login) & baca (link admin tanpa header auth)
    // Keamanan bersandar pada token download yang acak/tidak bisa ditebak.
    match /ktp/{tahun}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Blokir semua path lain
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
